# Patterns to exclude from the Docker build context.
# Keeping the context small speeds up `docker compose build`.
# NOTE: vendor/ is intentionally NOT excluded — it is copied into the builder
# stage so the Go toolchain doesn't need network access during the build.

# Git metadata
.git/
.gitignore

# Test databases
data/
*.db

# OS noise
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Go build artifacts
/auth-cli
/auth-cli-*
